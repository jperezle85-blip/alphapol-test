rules_version = '2';

// Reglas de seguridad de Alphapol.
// Se publican con: npx firebase-tools deploy --only firestore:rules
//
// Roles (campo "rol" en users/{uid}):
//   admin    → todo lo del profesor + alta y desactivación de profesores
//   profesor → promociones, solicitudes y alumnos
//   alumno   → solo su propia ficha
service cloud.firestore {
  match /databases/{database}/documents {

    function conectado() {
      return request.auth != null;
    }

    function miFicha() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Personal de la academia activo (profesor o administrador).
    function esStaff() {
      return conectado()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && miFicha().rol in ['profesor', 'admin']
        && miFicha().get('activo', true) == true;
    }

    function esAdmin() {
      return esStaff() && miFicha().rol == 'admin';
    }

    function texto(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // ---------- Fichas de usuario: users/{uid} ----------
    // { nombre, apellidos, email, rol, cursos: [ids], activo, creado, ultimoAcceso }
    match /users/{uid} {
      // Cada uno lee su ficha; el personal lee todas.
      allow read: if conectado() && (request.auth.uid == uid || esStaff());

      allow create: if
        // El administrador da de alta a cualquiera (profesores incluidos).
        esAdmin()
        // Un profesor solo da de alta alumnos.
        || (esStaff() && request.resource.data.rol == 'alumno')
        // El administrador inicial se crea su propia ficha la primera vez que entra.
        || (conectado()
            && request.auth.uid == uid
            && request.auth.token.email == 'jperezle85@gmail.com'
            && request.resource.data.rol == 'admin');

      allow update: if
        esAdmin()
        // Un profesor gestiona alumnos, pero no puede convertirlos en profesores.
        || (esStaff() && resource.data.rol == 'alumno' && request.resource.data.rol == 'alumno')
        // Cada usuario solo puede actualizar su fecha de último acceso.
        || (conectado()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcceso'])
            && request.resource.data.ultimoAcceso == request.time);

      // Las cuentas no se borran desde el portal (se desactivan).
      allow delete: if esAdmin();
    }

    // ---------- Promociones: cursos/{id} ----------
    // { nombre, descripcion, precio, creado }. Públicas para mostrarlas en la web.
    match /cursos/{id} {
      allow read: if true;
      allow write: if esStaff();
    }

    // ---------- Solicitudes de inscripción: solicitudes/{id} ----------
    // Cualquiera puede ENVIAR una solicitud (formulario público), pero solo
    // el personal puede leerlas, aprobarlas o rechazarlas.
    match /solicitudes/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['cursoId', 'cursoNombre', 'nombre', 'apellidos', 'email', 'uid', 'estado', 'aceptaPrivacidad', 'creado'])
        && request.resource.data.keys().hasAll(
            ['cursoId', 'cursoNombre', 'nombre', 'apellidos', 'email', 'estado', 'aceptaPrivacidad', 'creado'])
        && texto(request.resource.data.nombre, 60)
        && texto(request.resource.data.apellidos, 80)
        && texto(request.resource.data.email, 120)
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && texto(request.resource.data.cursoNombre, 150)
        && exists(/databases/$(database)/documents/cursos/$(request.resource.data.cursoId))
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.aceptaPrivacidad == true
        && request.resource.data.creado == request.time
        // Si viene de un alumno con sesión, uid y email deben ser los suyos.
        && (!('uid' in request.resource.data)
            || (conectado()
                && request.resource.data.uid == request.auth.uid
                && request.resource.data.email == request.auth.token.email));

      allow read, update, delete: if esStaff();
    }

    // Todo lo demás, cerrado por defecto hasta que lo construyamos.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
